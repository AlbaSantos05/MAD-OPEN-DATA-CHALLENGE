# Copia este fichero como .env (cp .env.example .env) y rellena tus datos.
# El .env NO se sube a GitHub; este .env.example sí.

# API de lectura del dataset (pública, de solo lectura). La usa el motor.
ORDS_URL=https://g65cd3d29f3f6ee-madcompanadb.adb.eu-madrid-1.oraclecloudapps.com/ords/maddata

# Solo para cargar datos en Oracle (pipelines/cargar_oracle.py). Necesita el puerto 1522:
# no funciona en eduroam, usa los datos del móvil.
ORACLE_USER=maddata
ORACLE_PASSWORD=
ORACLE_DSN=madcompanadb_low
ORACLE_WALLET_DIR=/ruta/completa/a/Wallet_MADcompanaDB
